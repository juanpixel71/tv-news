<?xml version='1.0' encoding='utf-8'?>
<widget id="com.miApp.reproductor" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ReproductorApp</name>
    <description>Reproductor de video personalizado mediante archivo JSON</description>
    <author email="soporte@miapp.com" href="https://github.com">Tu Nombre</author>
    
    <content src="index.html" />
    
    <!-- Icono global de la aplicación situado en la raíz -->
    <icon src="icon.png" />
    
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="*" />

    <preference name="ScrollEnabled" value="true" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="FadeSplashScreenDuration" value="300" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <preference name="SplashScreen" value="screen" />

    <platform name="android">
        <!-- Icono específico para Android -->
        <icon src="icon.png" />
        <allow-intent href="market:*" />
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
    </platform>
</widget>
